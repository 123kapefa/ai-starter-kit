{
  "_comment": "Codex: положить в .ai/hooks.json и сослаться из .ai/config.toml [hooks]. Для Claude Code — влить внутренний объект 'hooks' в .claude/settings.json (см. settings.hooks.json); это делает setup.sh.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Shell|exec_command|apply_patch|Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "python3 .ai/hooks/pre_tool_guard.py", "timeout": 5000 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "python3 .ai/hooks/post_tool_maintenance.py", "timeout": 3000 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 .ai/hooks/stop_maintenance.py", "timeout": 3000 }
        ]
      }
    ]
  }
}
